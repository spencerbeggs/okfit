{
	"description": "Teaches AI coding agents the Open Knowledge Format (OKF) v0.3 and keeps a repository's okf/ knowledge bundle current through skills, two docs agents, and the okfit CLI, MCP server and language server.",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "export PLUGINFINITY_EVENT='SessionStart'; sh \"${CLAUDE_PLUGIN_ROOT}/lib/pluginfinity/env-run.sh\"",
						"timeout": 15
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "env",
						"args": [
							"PLUGINFINITY_EVENT=SessionStart",
							"bash",
							"${CLAUDE_PLUGIN_ROOT}/hooks/session-start/orientation.sh"
						],
						"timeout": 10
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "env",
						"args": [
							"PLUGINFINITY_EVENT=PostToolUse",
							"bash",
							"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use/validate.sh"
						],
						"timeout": 30
					}
				]
			}
		]
	}
}
