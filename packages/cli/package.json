{
	"name": "@okfit/cli",
	"version": "0.16.2",
	"private": true,
	"description": "The okfit command line: validate, lint, index, and inspect Open Knowledge Format (OKF) bundles.",
	"keywords": ["okf", "open-knowledge-format", "cli", "effect"],
	"homepage": "https://github.com/spencerbeggs/okfit/tree/main/packages/cli#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/okfit/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/okfit.git",
		"directory": "packages/cli"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./main": "./src/main.ts",
		"./package.json": "./package.json"
	},
	"bin": {
		"okfit": "./src/bin.ts"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effected/cli-kit": "catalog:effected",
		"@effected/config-file": "catalog:effected",
		"@effected/env": "catalog:effected",
		"@effected/git": "catalog:effected",
		"@effected/glob": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/kit": "catalog:effected",
		"@effected/markdown": "catalog:effected",
		"@effected/schemastore": "catalog:effected",
		"@effected/source": "catalog:effected",
		"@effected/toml": "catalog:effected",
		"@effected/walker": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"@okfit/core": "workspace:*",
		"@okfit/engine": "workspace:*",
		"@okfit/profiles": "workspace:*",
		"effect": "catalog:effected",
		"ink": "catalog:silk",
		"react": "catalog:effected:build"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effected",
		"@effected/commands": "catalog:effected",
		"@effected/workspaces": "catalog:effected",
		"@types/node": "catalog:effected:build",
		"@types/react": "catalog:effected:build",
		"typescript": "catalog:effected:build",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
