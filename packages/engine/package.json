{
	"name": "@okfit/engine",
	"version": "0.2.1",
	"private": true,
	"description": "The okfit engine: platform layer, config discovery, and the validate, verify, sync, init and context programs shared by the okfit CLI and MCP server.",
	"keywords": ["okf", "open-knowledge-format", "effect"],
	"homepage": "https://github.com/spencerbeggs/okfit/tree/main/packages/engine#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/okfit/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/okfit.git",
		"directory": "packages/engine"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effected/app": "catalog:effected",
		"@effected/config-file": "catalog:effected",
		"@effected/git": "catalog:effected",
		"@effected/glob": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/markdown": "catalog:effected",
		"@effected/store": "catalog:effected",
		"@effected/toml": "catalog:effected",
		"@effected/walker": "catalog:effected",
		"@effected/xdg": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"@okfit/core": "workspace:*",
		"@okfit/profiles": "workspace:*",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@effected/memfs": "catalog:effected",
		"@savvy-web/bundler": "^2.3.6",
		"@types/node": "catalog:build",
		"typescript": "catalog:build",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
