{
	"$schema": "https://turborepo.com/schema.v2.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"cache": false,
			"dependsOn": [
				"@okfit/cli#build:prod",
				"@okfit/core#build:prod",
				"@okfit/engine#build:prod",
				"@okfit/lsp#build:prod",
				"@okfit/mcp#build:prod",
				"@okfit/plugin#build:prod",
				"@okfit/profiles#build:prod"
			],
			"outputLogs": "full",
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"dependsOn": ["build"],
			"persistent": true
		},
		"preview": {
			"cache": false,
			"dependsOn": ["build"],
			"persistent": true
		}
	}
}
