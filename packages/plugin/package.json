{
	"name": "@okfit/plugin",
	"version": "0.3.1",
	"private": true,
	"description": "Install this one package to get the okfit CLI and MCP server in your repository. Depends on @okfit/cli and @okfit/mcp.",
	"keywords": ["okf", "open-knowledge-format", "claude", "agent", "mcp", "cli"],
	"homepage": "https://github.com/spencerbeggs/okfit/tree/main/packages/plugin#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/okfit/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/okfit.git",
		"directory": "packages/plugin"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"bin": {
		"okfit": "./src/bin/okfit.ts",
		"okfit-mcp": "./src/bin/okfit-mcp.ts"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@okfit/cli": "workspace:*",
		"@okfit/mcp": "workspace:*"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@effected/commands": "catalog:effected",
		"@savvy-web/bundler": "^2.3.4",
		"@types/node": "catalog:build",
		"effect": "catalog:effect",
		"typescript": "catalog:build",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
