{
	"name": "@okfit/profiles",
	"version": "0.3.0",
	"private": true,
	"description": "Named OKF configuration profiles for okfit, starting with the software-project profile.",
	"keywords": ["okf", "open-knowledge-format", "profiles", "effect"],
	"homepage": "https://github.com/spencerbeggs/okfit/tree/main/packages/profiles#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/okfit/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/okfit.git",
		"directory": "packages/profiles"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@effected/commands": "catalog:effected",
		"@effected/git": "catalog:effected",
		"@effected/markdown": "catalog:effected",
		"@effected/toml": "catalog:effected",
		"@okfit/core": "workspace:*",
		"@savvy-web/bundler": "^2.3.2",
		"@types/node": "catalog:build",
		"effect": "catalog:effect",
		"typescript": "catalog:build",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@effected/git": "catalog:effected:peers",
		"@effected/markdown": "catalog:effected:peers",
		"@okfit/core": "workspace:^",
		"effect": "catalog:effect:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
