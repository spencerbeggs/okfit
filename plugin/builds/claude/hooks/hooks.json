{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "env",
						"args": [
							"PLUGINFINITY_EVENT=SessionStart",
							"bash",
							"${CLAUDE_PLUGIN_ROOT}/hooks/session-start/orientation.sh"
						],
						"timeout": 10
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "env",
						"args": [
							"PLUGINFINITY_EVENT=PostToolUse",
							"bash",
							"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use/validate.sh"
						],
						"timeout": 30
					}
				]
			}
		]
	}
}
