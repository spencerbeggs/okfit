{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"extends": ["@savvy-web/silk/biome"],
	"overrides": [
		{
			"includes": ["**/__test__/**"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		},
		{
			"formatter": { "enabled": false },
			"includes": ["schemas/**"]
		},
		{
			"assist": { "enabled": false },
			"formatter": { "enabled": false },
			"includes": ["plugin/builds/**"],
			"linter": { "enabled": false }
		}
	],
	"root": true
}
