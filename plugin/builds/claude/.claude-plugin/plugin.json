{
	"name": "okfit",
	"version": "0.10.0",
	"description": "Teaches AI coding agents the Open Knowledge Format (OKF) v0.2 and keeps a repository's okf/ knowledge bundle current through skills, two docs agents, and the okfit CLI, MCP server and language server.",
	"author": {
		"name": "C. Spencer Beggs",
		"url": "https://spencerbeg.gs"
	},
	"homepage": "https://github.com/spencerbeggs/okfit",
	"repository": "https://github.com/spencerbeggs/okfit.git",
	"license": "MIT",
	"mcpServers": {
		"mcp": {
			"command": "sh",
			"args": [
				"${CLAUDE_PLUGIN_ROOT}/bin/start-mcp.sh"
			],
			"env": {
				"PLUGINFINITY_HOST": "claude",
				"PLUGINFINITY_PLUGIN": "okfit",
				"PLUGINFINITY_LIB": "${CLAUDE_PLUGIN_ROOT}/lib/pluginfinity"
			}
		}
	},
	"lspServers": {
		"okfit": {
			"command": "sh",
			"args": [
				"${CLAUDE_PLUGIN_ROOT}/bin/start-lsp.sh",
				"--stdio"
			],
			"extensionToLanguage": {
				".md": "markdown"
			},
			"diagnostics": true,
			"env": {
				"PLUGINFINITY_HOST": "claude",
				"PLUGINFINITY_PLUGIN": "okfit",
				"PLUGINFINITY_LIB": "${CLAUDE_PLUGIN_ROOT}/lib/pluginfinity"
			}
		}
	}
}
