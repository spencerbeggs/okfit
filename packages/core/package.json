{
	"name": "@okfit/core",
	"version": "0.12.1",
	"private": true,
	"description": "Spec-level Open Knowledge Format (OKF) v0.2 schemas, bundle loading, graph, derivation, and validation for Effect.",
	"keywords": ["okf", "open-knowledge-format", "knowledge", "markdown", "frontmatter", "effect"],
	"homepage": "https://github.com/spencerbeggs/okfit/tree/main/packages/core#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/okfit/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/okfit.git",
		"directory": "packages/core"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"schema:build": "effected schema build lib/configs/schemastore.config.ts",
		"schema:check": "effected schema check lib/configs/schemastore.config.ts",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effected",
		"@effected/config-file": "catalog:effected",
		"@effected/glob": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/markdown": "catalog:effected",
		"@effected/memfs": "catalog:effected",
		"@effected/plugin": "catalog:effected",
		"@effected/schemastore": "catalog:effected",
		"@effected/source": "catalog:effected",
		"@effected/toml": "catalog:effected",
		"@effected/walker": "catalog:effected",
		"@effected/workspaces": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"@savvy-web/bundler": "^2.7.3",
		"@types/node": "catalog:build",
		"effect": "catalog:effected",
		"typescript": "catalog:build",
		"vitest": "catalog:test"
	},
	"peerDependencies": {
		"@effected/config-file": "catalog:effected",
		"@effected/glob": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/markdown": "catalog:effected",
		"@effected/schemastore": "catalog:effected",
		"@effected/source": "catalog:effected",
		"@effected/toml": "catalog:effected",
		"@effected/walker": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"effect": "catalog:effected"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
