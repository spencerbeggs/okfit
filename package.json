{
	"name": "okfit",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for okfit: Node.js tooling for the Open Knowledge Format (OKF).",
	"homepage": "https://github.com/spencerbeggs/okfit#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/okfit/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/okfit.git"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build:dev build:prod --log-order=grouped --log-prefix=none",
		"ci:build": "CI=\"true\" turbo run build:dev build:prod --log-order=grouped --output-logs=full --log-prefix=none",
		"ci:test": "CI=\"true\" turbo run build:prod --log-order=grouped --output-logs=errors-only --log-prefix=none && CI=\"true\" vitest run --passWithNoTests",
		"claude": "claude --plugin-dir plugin/builds/claude",
		"dev": "turbo run dev --filter=docs",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"plugin:build": "pluginfinity build plugin",
		"plugin:check": "pluginfinity build --check plugin",
		"prepare": "husky",
		"preview": "turbo run preview --filter=docs",
		"schema:build": "turbo run schema:build --filter=@okfit/core --output-logs=full",
		"schema:check": "turbo run schema:check --filter=@okfit/core",
		"scratchpad:check": "pnpm --filter scratchpad check",
		"scratchpad:probe": "pnpm --filter scratchpad probe",
		"scratchpad:reset": "pnpm --filter scratchpad reset",
		"test": "vitest run --passWithNoTests",
		"test:bats": "bats --recursive plugin/__test__",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"typecheck": "turbo run types:check --log-prefix=none --log-order=grouped",
		"types:check": "tsc --noEmit",
		"vscode:install": "pnpm vscode:package && node --experimental-strip-types vscode/lib/install-vsix.ts",
		"vscode:package": "turbo run build:dev --filter=@okfit/lsp && pnpm --filter @okfit/vscode-extension build && pnpm --filter @okfit/vscode-extension package"
	},
	"devDependencies": {
		"@okfit/cli": "workspace:*",
		"@okfit/plugin": "workspace:*",
		"@savvy-web/silk": "^4.3.5",
		"@vitest-agent/plugin": "^5.3.0",
		"pluginfinity": "^0.3.0"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.10.1",
			"onFail": "download"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.10.0",
				"onFail": "ignore"
			},
			{
				"name": "bun",
				"version": "1.4.2",
				"onFail": "ignore"
			}
		]
	}
}
