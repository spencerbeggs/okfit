{
	"name": "@okfit/lsp",
	"version": "0.2.0",
	"private": true,
	"description": "Language Server Protocol server for okfit: background diagnostics for an Open Knowledge Format (OKF) bundle in any LSP client, Claude Code included.",
	"keywords": ["okf", "open-knowledge-format", "lsp", "language-server", "claude", "effect"],
	"homepage": "https://github.com/spencerbeggs/okfit/tree/main/packages/lsp#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/okfit/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/okfit.git",
		"directory": "packages/lsp"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./main": "./src/main.ts",
		"./package.json": "./package.json"
	},
	"bin": {
		"okfit-lsp": "./src/bin.ts"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effected/git": "catalog:effected",
		"@effected/markdown": "catalog:effected",
		"@effected/xdg": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"@okfit/core": "workspace:*",
		"@okfit/engine": "workspace:*",
		"@okfit/profiles": "workspace:*",
		"effect": "catalog:effect",
		"vscode-languageserver": "^10.1.1"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@effected/workspaces": "catalog:effected",
		"@savvy-web/bundler": "^2.4.9",
		"@types/node": "catalog:build",
		"typescript": "catalog:build",
		"vitest": "catalog:test",
		"vscode-jsonrpc": "^9.0.2"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
