{
	"name": "okfit",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for okfit: Node.js tooling for the Open Knowledge Format (OKF).",
	"homepage": "https://github.com/spencerbeggs/okfit#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/okfit/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/okfit.git"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build:dev build:prod --log-order=grouped --log-prefix=none",
		"ci:build": "CI=\"true\" turbo run build:dev build:prod --log-order=grouped --output-logs=full --log-prefix=none",
		"ci:test": "CI=\"true\" vitest run --passWithNoTests",
		"claude": "claude --plugin-dir plugins/claude-code",
		"generate-schema": "tsx lib/scripts/generate-schema.ts",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"prepare": "husky",
		"test": "vitest run --passWithNoTests",
		"test:bats": "bats --recursive plugins",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"typecheck": "turbo run types:check --log-prefix=none --log-order=grouped",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effected/schemastore": "catalog:effected",
		"@effected/toml": "catalog:effected",
		"@okfit/cli": "workspace:*",
		"@okfit/core": "workspace:*",
		"@okfit/mcp": "workspace:*",
		"@okfit/plugin": "workspace:*",
		"@savvy-web/silk": "^3.14.0",
		"@vitest-agent/plugin": "^3.0.1",
		"ajv": "^8.20.0",
		"bats": "^1.13.0",
		"effect": "catalog:effect",
		"tsx": "^4.23.13",
		"vitest": "catalog:test"
	},
	"packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664",
	"engines": {
		"node": ">=24.11.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664",
			"onFail": "ignore"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.8.1",
				"onFail": "ignore"
			}
		]
	}
}
