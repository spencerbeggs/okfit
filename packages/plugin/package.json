{
	"name": "@okfit/plugin",
	"version": "0.5.34",
	"private": true,
	"description": "Install this one package to get the okfit CLI, MCP server and LSP server in your repository. Depends on @okfit/cli, @okfit/mcp and @okfit/lsp.",
	"keywords": ["okf", "open-knowledge-format", "claude", "agent", "mcp", "cli"],
	"homepage": "https://github.com/spencerbeggs/okfit/tree/main/packages/plugin#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/okfit/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/okfit.git",
		"directory": "packages/plugin"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"bin": {
		"okfit": "./src/bin/okfit.ts",
		"okfit-lsp": "./src/bin/okfit-lsp.ts",
		"okfit-mcp": "./src/bin/okfit-mcp.ts"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@okfit/cli": "workspace:*",
		"@okfit/lsp": "workspace:*",
		"@okfit/mcp": "workspace:*"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effect/vitest": "catalog:effected",
		"@effected/lsp": "catalog:effected",
		"@effected/mcp-kit": "catalog:effected",
		"@effected/workspaces": "catalog:effected",
		"@types/node": "catalog:effected:build",
		"effect": "catalog:effected",
		"typescript": "catalog:effected:build",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
